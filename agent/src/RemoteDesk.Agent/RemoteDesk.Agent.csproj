<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RemoteDesk</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Product>Couchpad</Product>
    <!-- Так программа называется в диспетчере задач и в списке автозагрузки. Имя файла пока прежнее:
         на него настроены брандмауэр и автозапуск, сменим вместе с установщиком. -->
    <AssemblyTitle>Couchpad</AssemblyTitle>
    <Company>Couchpad</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteDesk.Agent.Core\RemoteDesk.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
