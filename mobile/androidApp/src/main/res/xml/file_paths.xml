<?xml version="1.0" encoding="utf-8"?>
<!-- Скачанное на Android 8–9 лежит в папке приложения; через FileProvider его можно открыть другой программой. -->
<paths>
    <external-files-path name="downloads" path="Download/" />
    <!-- Картинка с ПК для буфера обмена: её читает приложение, куда её вставят. -->
    <cache-path name="clip" path="clip/" />
</paths>
